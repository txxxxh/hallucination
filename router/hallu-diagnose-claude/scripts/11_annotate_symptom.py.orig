"""Symptom 标注 (独立于 stressor 真值的第二观测通道)。
流程:
  1) 用推理模型对已入组的 flip 样本重新生成完整 thinking trace (10_screen 只存了尾部);
  2) 用 judge 模型按 rubric 从 trace 标注 symptom (S1-S4, 可多选);
  3) 输出 symptom 标签 + symptom x stressor 混淆矩阵 + H(Z|S) + symptom-MAP baseline。

重要: rubric 判读的是错误在轨迹上"显现"的位置与形态 (表型), 不是错误原因。
      judge 的输入里绝不包含 stressor 标签或构造信息 (防泄漏)。
用法:
  python scripts/11_annotate_symptom.py --gen   # 步骤1: 生成 trace
  python scripts/11_annotate_symptom.py --judge # 步骤2: 标注
  python scripts/11_annotate_symptom.py --stats # 步骤3: 混淆分析
  python scripts/11_annotate_symptom.py --gen --incremental
  python scripts/11_annotate_symptom.py --judge --incremental
"""
import argparse, json, math, re
from collections import Counter, defaultdict
from common import read_jsonl, write_jsonl, DATA, LM

STRESSORS = ["z1", "z2", "z3", "z4", "z6"]

RUBRIC = """You are annotating the OBSERVABLE ERROR PHENOTYPE in a model's reasoning trace.
Classify WHERE and HOW the error surfaces in the trace -- NOT why it happened.

Labels (multi-select allowed, pick all that visibly apply):
S1 factual_error: the trace states a specific factual claim (entity, date, attribution,
   formula, definition) that is false. E.g., asserts a wrong award, wrong constant.
S2 tool_error: the trace should have deferred to an external resource/tool (lookup, search,
   calculator) but instead fabricates the artifact (invented citation/URL/value), or misuses
   a stated tool result. Only if the task context makes external grounding clearly expected.
S3 evidence_misuse: the trace visibly latches onto wrong parts of the given input --
   uses an irrelevant sentence/number from the prompt, follows a surface association named
   in the prompt, ignores a stated constraint, or answers a different question than asked.
S4 execution_error: the reasoning plan is sensible and premises are fine, but a step is
   executed wrongly -- arithmetic slip, wrong substitution, invalid logical step, or the
   trace is visibly cut off / rushed before completing the plan.
S0 none_visible: the final answer is wrong but the trace shows no visible error (e.g.,
   confident direct assertion with no reasoning shown).

Negative guidance:
- Do NOT infer hidden causes ("the model probably never learned this") -- phenotype only.
- A wrong fact stated fluently = S1 even if you suspect the cause is association.
- Using an irrelevant number from the question = S3 even though the resulting arithmetic
  claim is also false; S3 takes precedence over S1 when the wrong material visibly comes
  from the prompt. Add S1 as well only if there is an ADDITIONAL prompt-independent false claim.

Question given to the model:
{question}

Gold answer: {gold}

Model's trace and answer:
{trace}

Return JSON only: {{"labels": ["S1"...], "error_span": "<=30 words quoted from trace where the error first surfaces", "rationale": "<=25 words"}}"""

def gen_traces(model, tp, stressors=STRESSORS, incremental=False):
    lm = LM(model, tp=tp)
    assert lm.is_reasoner, "trace 生成需要推理模型 (thinking 可见)"
    for z in stressors:
        p = DATA / f"processed/{z}_final.jsonl"
        if not p.exists():
            continue
        samples = read_jsonl(p)
        targets = ([s for s in samples if not s.get("meta", {}).get("full_trace")]
                   if incremental else samples)
        if not targets:
            print(f"[trace] {z}: 0/{len(samples)}（无需补充）")
            continue
        # Z4 用其入组时的截断 budget 复现故障 trace, 其余 full budget
        if z == "z4":
            buckets = defaultdict(list)
            for s in targets:
                buckets[s["meta"]["cut_think_tokens"]].append(s)
            for b, grp in buckets.items():
                gens = lm.chat([s["q_trig"] for s in grp], temperature=0.0, max_think=b)
                for s, g in zip(grp, gens):
                    s["meta"]["full_trace"] = g[0]
        else:
            gens = lm.chat([s["q_trig"] for s in targets], temperature=0.0, max_think=4096)
            for s, g in zip(targets, gens):
                s["meta"]["full_trace"] = g[0]
        write_jsonl(samples, DATA / f"processed/{z}_final.jsonl")
        print(f"[trace] {z}: {len(targets)}/{len(samples)}")

def judge(judge_model, tp, stressors=STRESSORS, incremental=False):
    """judge 输入只含 question/gold/trace, 不含 stressor —— 防泄漏。
    judge_model 可以是本地大模型或换成 API 调用。"""
    lm = LM(judge_model, tp=tp)
    for z in stressors:
        p = DATA / f"processed/{z}_final.jsonl"
        if not p.exists():
            continue
        samples = read_jsonl(p)
        targets = [s for s in samples if s.get("meta", {}).get("full_trace")]
        if incremental:
            targets = [s for s in targets if not s.get("symptom")]
        if not targets:
            print(f"[judge] {z}: 0/{len(samples)}（无需补充）")
            continue
        prompts = [RUBRIC.format(question=s["q_trig"], gold=s["answer"],
                                 trace=s["meta"]["full_trace"][:6000]) for s in targets]
        gens = lm.chat(prompts, temperature=0.0, max_tokens=300)
        n_ok = 0
        for s, g in zip(samples, gens):
            try:
                txt = g[0]
                obj = json.loads(txt[txt.index("{"): txt.rindex("}") + 1])
                labs = [l for l in obj.get("labels", []) if re.fullmatch(r"S[0-4]", l)]
                s["symptom"] = labs or ["S0"]
                s["symptom_span"] = obj.get("error_span", "")
                n_ok += 1
            except (ValueError, json.JSONDecodeError):
                s["symptom"] = ["PARSE_FAIL"]
        write_jsonl(samples, DATA / f"processed/{z}_final.jsonl")
        print(f"[judge] {z}: {n_ok}/{len(samples)} 标注成功")

def stats(stressors=STRESSORS):
    rows = []
    for z in stressors:
        p = DATA / f"processed/{z}_final.jsonl"
        if p.exists():
            rows += [s for s in read_jsonl(p) if s.get("symptom") and s["symptom"] != ["PARSE_FAIL"]]
    if not rows:
        print("[warning] 没有可用于 symptom 统计的成功标注样本")
        return
    # 主 symptom = 列表第一个 (混淆矩阵用单标签视图, 多标签视图在附录)
    cm = defaultdict(Counter)
    for s in rows:
        cm[s["symptom"][0]][s["stressor"]] += 1
    symptoms = sorted(cm)
    stressors = sorted({s["stressor"] for s in rows})
    print("\n===== Symptom x Stressor 混淆矩阵 (行=symptom, 列=stressor) =====")
    print("        " + "  ".join(f"{z:>5}" for z in stressors))
    for sy in symptoms:
        print(f"{sy:>6}  " + "  ".join(f"{cm[sy][z]:>5}" for z in stressors))

    # H(Z), H(Z|S), symptom-MAP baseline
    n = len(rows)
    pz = Counter(s["stressor"] for s in rows)
    hz = -sum(c / n * math.log2(c / n) for c in pz.values())
    hzs, map_correct = 0.0, 0
    for sy in symptoms:
        m = sum(cm[sy].values())
        hzs += m / n * -sum(c / m * math.log2(c / m) for c in cm[sy].values())
        map_correct += cm[sy].most_common(1)[0][1]
    print(f"\nH(Z) = {hz:.3f} bits;  H(Z|S) = {hzs:.3f} bits;  互信息 = {hz - hzs:.3f}")
    print(f"symptom-MAP 诊断准确率 = {map_correct / n:.1%}  <- router 必须显著打败这个数")
    print(f"多数类 baseline = {pz.most_common(1)[0][1] / n:.1%}")

if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--gen", action="store_true")
    ap.add_argument("--judge", action="store_true")
    ap.add_argument("--stats", action="store_true")
    ap.add_argument("--model", default="deepseek-ai/DeepSeek-R1-Distill-Llama-8B")
    ap.add_argument("--judge_model", default="NousResearch/Meta-Llama-3.1-8B-Instruct")
    ap.add_argument("--tp", type=int, default=1)
    ap.add_argument("--stressors", nargs="+", default=STRESSORS)
    ap.add_argument("--incremental", action="store_true",
                    help="--gen 只补 full_trace；--judge 只补 symptom，不覆盖已有标注")
    a = ap.parse_args()
    if a.gen:
        gen_traces(a.model, a.tp, a.stressors, a.incremental)
    if a.judge:
        judge(a.judge_model, a.tp, a.stressors, a.incremental)
    if a.stats:
        stats(a.stressors)
