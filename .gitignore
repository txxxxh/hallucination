# Keep the repository split into the two project trees. Ignore unrelated
# home-directory state because this repository is checked out at $HOME.
*
!.gitignore
!blackbox/
!blackbox/**
!whitebox/
!whitebox/**

# Never add regenerated local environment and cache files under whitebox.
whitebox/**/__pycache__/
whitebox/**/*.pyc
whitebox/**/*.pyo
whitebox/**/*.log
whitebox/.venv/

# Reproducible experiment artifacts and third-party working copies.
whitebox/**/*.pt
whitebox/**/*.npz
whitebox/**/*.npy
whitebox/**/*.arrow
whitebox/**/*.safetensors
whitebox/**/*.bin
whitebox/**/*.orig
whitebox/**/*.rej
whitebox/**/cache/
whitebox/**/hidden/
whitebox/**/hidden
whitebox/**/features/
whitebox/**/item_cache/
whitebox/**/items/
whitebox/perturbation/runs/**/models/
whitebox/perturbation/runs/**/status/
whitebox/perturbation/runs/**/question_*.json
whitebox/HallucinationPatternDetection/
whitebox/perturbation/third_party/
whitebox/third_party/
